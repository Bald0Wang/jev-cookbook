# Copy to .env and fill in the keys you actually have.
# Only set keys for providers you plan to run; missing ones will fail-fast at request time.
# Keys are read via --key-env and passed to the adapter; nothing else.

# DeepSeek  (https://api-docs.deepseek.com/)
DEEPSEEK_API_KEY=

# 阿里 Qwen / DashScope  (https://dashscope.aliyuncs.com/)
DASHSCOPE_API_KEY=

# 智谱 GLM  (https://open.bigmodel.cn/)
ZHIPU_API_KEY=

# Moonshot Kimi  (https://api.moonshot.cn/)
MOONSHOT_API_KEY=

# 字节豆包 / 火山方舟  (https://www.volcengine.com/product/ark)
ARK_API_KEY=

# 阶跃星辰 StepFun  (https://platform.stepfun.com/)
STEPFUN_API_KEY=

# 小米 MiMo  (https://api.xiaomi.com/)  — 占位，若官方未公开则保留空
XIAOMI_API_KEY=