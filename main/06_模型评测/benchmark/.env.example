# Copy to .env and fill in the keys you actually have.
# Laya-local 不要任何 key（默认监听 127.0.0.1:8811，无鉴权）
# Jev API 必须从 https://console.typesafe.ai/keys 获取

# === TypeSafe AI (Jev native System One) ===
# 注册送少量免费额度: https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# === Laya 本机 serve ===
# 单独的环境变量，控制 device 与 model dir
LAYA_MODEL_DIR=
LAYA_DEVICE=mps
LAYA_HOST=127.0.0.1
LAYA_PORT=8811